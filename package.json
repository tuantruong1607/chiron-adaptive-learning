{
  "name": "chiron-adaptive-learning",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "pnpm --filter @chiron/web dev",
    "build": "pnpm --filter @chiron/domain build && pnpm --filter @chiron/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
