FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# The AWS profile uses Qdrant Cloud Inference. Keeping FastEmbed out of this
# image removes the 2+ GB model/cache footprint from the EC2 worker.
COPY pyproject.toml ./
RUN mkdir -p chiron_worker && touch chiron_worker/__init__.py \
    && pip install --no-cache-dir .

COPY chiron_worker ./chiron_worker
COPY scripts ./scripts
RUN pip install --no-cache-dir --no-deps . \
    && useradd --create-home --uid 10001 chiron

USER chiron
EXPOSE 9108

# One small process handles both queued tasks and the periodic schedule.
CMD ["celery", "-A", "chiron_worker.app:celery_app", "worker", "--beat", "--loglevel=INFO", "--pool=solo", "--without-gossip", "--without-mingle", "--without-heartbeat"]
