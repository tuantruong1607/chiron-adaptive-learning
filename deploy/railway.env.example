# API service
APP_ENV=production
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://runtime-user:runtime-password@postgres-private:5432/chiron
DATABASE_ADMIN_URL=postgresql+psycopg://owner-user:owner-password@postgres-private:5432/chiron
REDIS_URL=redis://redis-private:6379/0
QDRANT_URL=http://qdrant-private:6333
QDRANT_API_KEY=
APP_BASE_URL=https://chiron-web.example.com
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_MODE=oidc
OIDC_ISSUER_URL=https://identity.example.com
OIDC_AUDIENCE=chiron-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
WORKER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
OPS_METRICS_TOKEN=replace-with-at-least-32-random-characters
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_ON_QUOTA=true
LLM_FALLBACK_ON_UNAVAILABLE=true
LLM_FALLBACK_ALLOWED_SENSITIVITIES=public,synthetic
GRAPH_LITE_ENABLED=true
ESSAY_GRADING_SLA_MINUTES=15

# Worker service
WORKER_DATABASE_URL=postgresql://runtime-user:runtime-password@postgres-private:5432/chiron
QDRANT_COLLECTION=chiron_chunks_v1
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_VERSION=multilingual-e5-large-mean-batch32-v2
OPENAI_DOCUMENT_EMBEDDING_ALLOWED=false
RERANK_ENABLED=false
RETRIEVAL_MAX_SUBQUERIES=1
GRAPH_VERSION_STATUS=active
GRAPH_REVIEW_STATUS=active
RETENTION_ENABLED=true
RETENTION_DRY_RUN=false
RETENTION_LEARNER_CONTENT_DAYS=90
RETENTION_PROCESSED_OUTBOX_DAYS=30
RETENTION_AUTH_SESSION_GRACE_DAYS=30

# Web service
API_BASE_URL=http://chiron-api.railway.internal:8000
WEB_BASE_URL=https://chiron-web.example.com
WEB_TRUSTED_ORIGINS=https://chiron-web.example.com
OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
OIDC_TOKEN_URL=https://identity.example.com/oauth/token
OIDC_CLIENT_ID=replace-with-live-client-id
OIDC_CLIENT_SECRET=replace-with-live-client-secret
OIDC_REDIRECT_URI=https://chiron-web.example.com/api/auth/oidc/callback
