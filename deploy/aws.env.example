# AWS EC2 + Docker Compose profile. Copy to deploy/aws.env and fill every value.
DEPLOYMENT_PROFILE=aws-free
WEB_BASE_URL=https://learn.example.com
WEB_TRUSTED_ORIGINS=https://learn.example.com
WEB_PORT=80

POSTGRES_DB=chiron
POSTGRES_USER=chiron
POSTGRES_PASSWORD=replace-with-a-long-random-password

QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=chiron_chunks_aws_free_v1
EMBEDDING_PROVIDER=qdrant_cloud
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VERSION=qdrant-cloud-all-minilm-l6-v2-v1
SPARSE_EMBEDDING_MODEL=qdrant/bm25
QDRANT_INFERENCE_DENSE_SIZE=384
QDRANT_CLOUD_DOCUMENT_INFERENCE_ALLOWED=true
OPENAI_DOCUMENT_EMBEDDING_ALLOWED=false

AUTH_MODE=oidc
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
WORKER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
OPS_METRICS_TOKEN=replace-with-at-least-32-random-characters
OIDC_ISSUER_URL=https://identity.example.com
OIDC_AUDIENCE=chiron-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_AUTHORIZATION_URL=https://identity.example.com/authorize
OIDC_TOKEN_URL=https://identity.example.com/oauth/token
OIDC_CLIENT_ID=replace-with-live-client-id
OIDC_CLIENT_SECRET=replace-with-live-client-secret
OIDC_REDIRECT_URI=https://learn.example.com/api/auth/oidc/callback

LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-groq-api-key
GEMINI_API_KEY=
LLM_FALLBACK_ENABLED=true
ESSAY_GRADING_SLA_MINUTES=15
OUTBOX_POLL_SECONDS=15
RETENTION_LEARNER_CONTENT_DAYS=90
RETENTION_PROCESSED_OUTBOX_DAYS=30
RETENTION_AUTH_SESSION_GRACE_DAYS=30
